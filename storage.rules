rules_version = '2';

// Photo storage rules.
// - Job photos live under jobs/<jobId>/<photo>.jpg — uploadable by any
//   job-working role (manager/technician/mechanic/driver).
// - Grade photos live under gradeTasks/<taskId>/<photo>.jpg — uploadable by
//   graders and managers.
// Any signed-in user can view; uploads are capped at 10 MB and must be images.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : "none";
    }
    function isOwner() { return signedIn() && request.auth.token.email == "soonersod@gmail.com"; }
    function canJobs()  { return isOwner() || role() == "manager" || role() == "technician" || role() == "mechanic" || role() == "driver"; }
    function canGrade() { return isOwner() || role() == "manager" || role() == "grader"; }

    match /jobs/{jobId}/{photo} {
      allow read: if signedIn();
      allow create, update: if canJobs()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if canJobs();
    }

    match /gradeTasks/{taskId}/{photo} {
      allow read: if signedIn();
      allow create, update: if canGrade()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if canGrade();
    }

    // Anything not matched above is denied.
  }
}

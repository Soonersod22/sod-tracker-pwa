rules_version = '2';

// Role-based rules for the Sod Job Tracker.
// Each signed-in user has a doc at users/{uid} with a `role`:
//   "manager" | "technician" | "semi" | "unassigned"
// - Managers: full access to jobs, drops, and crew roles.
// - Technicians: read + create/edit OPEN jobs only (no delete, no drops).
// - Semi drivers: read + create drops only (no delete, no jobs).
// - Unassigned / signed-out: no access to data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "none";
    }
    // The owner email is always a manager (bootstrap on first login).
    function isOwner()    { return signedIn() && request.auth.token.email == "soonersod@gmail.com"; }
    function isManager()  { return myRole() == "manager" || isOwner(); }
    // Mechanics work jobs like technicians (plus the Shop, added later).
    function canSeeJobs() { return myRole() == "manager" || myRole() == "technician" || myRole() == "mechanic"; }
    function canSeeDrops(){ return myRole() == "manager" || myRole() == "semi"; }
    // Any assigned role — used for shared Places.
    function hasAccess()  { return myRole() == "manager" || myRole() == "technician" || myRole() == "mechanic" || myRole() == "semi"; }
    // Shop = managers and mechanics.
    function canShop()    { return isManager() || myRole() == "mechanic"; }
    // A job's status ("open" if missing, for legacy docs).
    function statusOf(d)     { return ("status" in d) ? d.status : "open"; }
    function openOrMeasured(s){ return s == "open" || s == "measured"; }

    match /jobs/{jobId} {
      allow read:   if canSeeJobs();
      // Managers can create any status; the crew can create Open jobs or
      // Measured yards (no Upcoming/Completed).
      allow create: if canSeeJobs() && request.resource.data.size() <= 60
                    && (isManager() || openOrMeasured(statusOf(request.resource.data)));
      // Managers can edit anything; the crew can edit Open/Measured items and
      // move between those two (so they can't complete or schedule).
      allow update: if canSeeJobs() && request.resource.data.size() <= 60
                    && (isManager() || (openOrMeasured(statusOf(resource.data)) && openOrMeasured(statusOf(request.resource.data))));
      // Managers delete anything; the crew may delete a Measured yard (scratch).
      allow delete: if isManager() || (canSeeJobs() && statusOf(resource.data) == "measured");
    }

    match /drops/{dropId} {
      allow read:          if canSeeDrops();
      allow create, update:if canSeeDrops() && request.resource.data.size() <= 60;
      allow delete:        if isManager();
    }

    // Saved Google Maps pins — every signed-in role can view and add/edit;
    // only managers can delete.
    match /pins/{pinId} {
      allow read:           if hasAccess();
      allow create, update: if hasAccess() && request.resource.data.size() <= 20;
      allow delete:         if isManager();
    }

    // Shop parts inventory — managers and mechanics view/add/edit; mechanics
    // request deletion via the pendingDelete flag (an update); only managers
    // hard-delete.
    match /parts/{partId} {
      allow read:           if canShop();
      allow create, update: if canShop() && request.resource.data.size() <= 40;
      allow delete:         if isManager();
    }

    // Fleet vehicles (trucks & equipment) — same access model as parts.
    match /vehicles/{vehicleId} {
      allow read:           if canShop();
      allow create, update: if canShop() && request.resource.data.size() <= 40;
      allow delete:         if isManager();
    }

    // Service records logged against vehicles.
    match /serviceRecords/{recordId} {
      allow read:           if canShop();
      allow create, update: if canShop() && request.resource.data.size() <= 40;
      allow delete:         if isManager();
    }

    match /users/{uid} {
      // A user can read their own role; managers can read everyone (crew list).
      allow get:  if signedIn() && (request.auth.uid == uid || isManager());
      allow list: if isManager();
      // New sign-ups self-provision their own doc as "unassigned" only.
      allow create: if signedIn() && uid == request.auth.uid
                    && request.resource.data.role == "unassigned";
      // Only managers change roles or remove people.
      allow update, delete: if isManager();
    }
  }
}
